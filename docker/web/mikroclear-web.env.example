# Mikro-Clear Web control plane
# Copy to a private env file and chmod 600. Never commit live secrets.

MIKROCLEAR_WEB_HOST=0.0.0.0
MIKROCLEAR_WEB_PORT=8080
MIKROCLEAR_WEB_ADMIN_USERNAME=admin
MIKROCLEAR_WEB_ADMIN_PASSWORD=
MIKROCLEAR_WEB_SESSION_SECRET=
MIKROCLEAR_WEB_SECURE_COOKIE=true
MIKROCLEAR_WEB_CONFIRM_TTL_SECONDS=120
MIKROCLEAR_WEB_EVE_JSON=/data/eve.json
MIKROCLEAR_WEB_LOG_FILE=
MIKROCLEAR_WEB_MAX_TAIL_BYTES=4194304

# RouterOS API-SSL. Use a dedicated least-privilege RouterOS account.
MIKROCLEAR_ROUTER_IP=
MIKROCLEAR_ROUTER_PORT=8729
MIKROCLEAR_ROUTER_USERNAME=
MIKROCLEAR_ROUTER_PASSWORD=
MIKROCLEAR_USE_SSL=true
MIKROCLEAR_ROUTER_TLS_SERVER_NAME=
MIKROCLEAR_CA_FILE=/etc/mikroclear/certs/mikrotik-ca.crt
MIKROCLEAR_ALLOW_SELF_SIGNED_CERTS=false

# Existing Mikro-Clear policy. Keep monitor-only true for first launch.
MIKROCLEAR_MONITOR_ONLY=true
MIKROCLEAR_BLOCK_LIST_NAME=Suricata
MIKROCLEAR_BLOCK_TIMEOUT=1d
MIKROCLEAR_ENABLE_IPV6=false

# Managed Mangle UI. Existing safety boundaries still apply.
MIKROCLEAR_MANGLE_CONTROL_ENABLE=false
MIKROCLEAR_MANGLE_COMMENT_PREFIX=MC:
MIKROCLEAR_MANGLE_ALLOWED_CHAINS=prerouting
MIKROCLEAR_MANGLE_ALLOWED_ACTIONS=mark-routing
MIKROCLEAR_MANGLE_REQUIRE_CONFIRMATION=true

# Optional status-only integrations shown in the UI.
MIKROCLEAR_TELEGRAM_ENABLE=false
MIKROCLEAR_TELEGRAM_TOKEN=
MIKROCLEAR_TELEGRAM_CHATID=
MIKROCLEAR_PARENTAL_CONTROL_ENABLE=false
MIKROCLEAR_PIHOLE_ENABLE=false
MIKROCLEAR_PIHOLE_BASE_URL=
MIKROCLEAR_PIHOLE_APP_PASSWORD=

# Web actions are written to a private JSONL audit file in this volume.
MIKROCLEAR_BOT_AUDIT_LOG=/var/lib/mikroclear/bot-audit.log
