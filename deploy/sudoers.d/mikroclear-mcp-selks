    /usr/bin/systemctl status mikroclear.service --no-pager, \
    /usr/bin/systemctl status mikroclear.service --no-pager --lines=20, \
    /usr/bin/systemctl enable mikroclear.service, \
    /usr/bin/systemctl restart mikroclear.service, \
    /usr/bin/journalctl -u mikroclear.service -n 100 --no-pager, \
