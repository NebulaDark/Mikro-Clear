# Copy to /etc/mikrocata/mikrocataTZSP0.env on selks and fill secrets there.

MIKROCATA_ROUTER_USERNAME=mikrocata2selks
MIKROCATA_ROUTER_PASSWORD=
MIKROCATA_ROUTER_IP=192.168.10.1
MIKROCATA_USE_SSL=true
MIKROCATA_ROUTER_PORT=8729
MIKROCATA_ALLOW_SELF_SIGNED_CERTS=false
MIKROCATA_CA_FILE=/etc/mikrocata/certs/mikrotik-ca.crt

MIKROCATA_BLOCK_LIST_NAME=Suricata
MIKROCATA_BLOCK_TIMEOUT=1d
MIKROCATA_MONITOR_ONLY=false

MIKROCATA_TELEGRAM_ENABLE=false
MIKROCATA_TELEGRAM_TOKEN=
MIKROCATA_TELEGRAM_CHATID=

MIKROCATA_WAN_IP=
MIKROCATA_LOCAL_IP_PREFIX=192.168.0.0/16
MIKROCATA_WHITELIST_IPS=
MIKROCATA_ENABLE_IPV6=false

MIKROCATA_SEVERITY=1,2
MIKROCATA_LISTEN_INTERFACES=tzsp0
MIKROCATA_ADD_ON_START=false
MIKROCATA_DEBUG=false

MIKROCATA_SURICATA_LOG_DIR=/opt/SELKS/docker/containers-data/suricata/logs/
MIKROCATA_EVE_JSON=/opt/SELKS/docker/containers-data/suricata/logs/eve.json
MIKROCATA_STATE_DIR=/var/lib/mikrocata
MIKROCATA_SAVE_INTERVAL=300

MIKROCATA_ASSET_RESOLVER_ENABLE=true
MIKROCATA_ASSET_RESOLVER_PRIVATE_ONLY=true
MIKROCATA_ASSET_RESOLVER_DHCP_ENABLE=true
MIKROCATA_ASSET_RESOLVER_PTR_ENABLE=true
MIKROCATA_ASSET_RESOLVER_CACHE_TTL=3600
